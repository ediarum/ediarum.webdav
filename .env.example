# ---------------------------------------------------------------------------------------------
# Docker (compose.yaml): Compose reads this file only to fill in the ${VAR}s of compose.yaml;
# the containers get no .env. These are all the variables it uses. Behind ediarum.platform the
# same variables go in the platform's env/webdav.env. compose.yaml fixes everything else itself
# (DB_HOST=webdav-db, DB_PORT=3306, APP_ENV=production, QUEUE_CONNECTION/CACHE_DRIVER/
# SESSION_DRIVER=database, LOG_CHANNEL=stderr, REPOSITORIES_DIRECTORY=/data/repositories, ...).
#
# Without Docker (php artisan serve, see documentation/DEVELOPMENT.md) Laravel reads this file
# directly; the section at the bottom is only for that case.
# ---------------------------------------------------------------------------------------------

# Image tag, e.g. the release the platform pins.
WEBDAV_VERSION=dev

# Required. Generate with `php artisan key:generate --show` (or key:generate without Docker).
APP_KEY=
# Where the app itself runs (admin interface and API, through the platform). Origin only, no path.
APP_URL=https://ediarum.example.org
# Optional: where WebDAV clients (Oxygen) connect, if not on APP_URL. Origin only, no path; empty or
# missing means APP_URL. The endpoint shown in the admin interface is
# WEBDAV_ORIGIN (or APP_URL) + APP_SUBPATH + /connection/<slug>.
# WEBDAV_ORIGIN=https://webdav.example.org
# Path prefix of the WebDAV endpoint; the proxy in front strips it before forwarding. Keep /webdav
# (also the default when the line is missing); set it empty when nothing strips it, e.g. localhost:8080.
APP_SUBPATH=/webdav
# Set to false to take the admin API out of service without a deploy -- see config/app.php.
ADMIN_PANEL_ENABLED=true
LOG_LEVEL=info

# MariaDB (the webdav-db service is created with these). DB_PASSWORD and DB_ROOT_PASSWORD are
# required.
DB_DATABASE=ediarum_webdav
DB_USERNAME=ediarum_webdav
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Required. Host directory holding every project's git repository, one subdirectory per project
# slug (see planning/init-project.md); mounted at /data/repositories. Must be writable by uid 33
# (www-data in the image).
WEBDAV_REPOSITORIES_DIR=

GIT_PATH=git
# Author of the commits webdav makes for WebDAV changes (the editor is named in the message).
APP_GIT_USER_NAME="ediarum.webdav"
APP_GIT_USER_EMAIL="webdav@example.org"

# Fallback Git remote credentials used to retry a push if it fails because a project's own
# git_username/git_access_token are no longer valid. Leave blank to disable the
# fallback (a push that fails authentication will just fail, as before).
GIT_MASTER_USERNAME=
GIT_MASTER_ACCESS_TOKEN=
# How long (seconds) a `git push` to the Git remote is allowed to run before PushToGitRemote gives
# up and marks it failed. Runs on the background `git-remote` queue, not in front of any HTTP request, so
# there's little cost to keeping this generous for a large or slow push.
GIT_PUSH_TIMEOUT=60

# First admin. Created by `db:seed` (the webdav-migrate service runs it on every start) only
# while there are no users at all.
INITIAL_USER_NAME="John Doe"
INITIAL_USER_EMAIL="admin@example.org"
INITIAL_USER_PASSWORD="startthisproject"

# Base URL of the ediarum services and the Bearer token sent to them. When both are set, every
# change in each project with "Push to ediarum services" turned on is pushed there
# (POST {url}/files). Leave either blank to push nothing.
EDIARUM_SERVICES_URL=
EDIARUM_SERVICES_API_KEY=

# Bearer token for the platform's service-side endpoints (GET /api/auth/service/projects), given to
# every app backend that calls them. Generate with `openssl rand -hex 32`. Blank: they answer 401.
SERVICE_TOKEN=

# webdav is the auth provider for the whole platform: this session (and its lifetime) is the
# platform login. The cookie is always `ediarum_session`, host-only (no SESSION_DOMAIN).
SESSION_LIFETIME=120
# Only for plain-HTTP local testing (localhost:8080): set to false.
SESSION_SECURE_COOKIE=true

# At the moment, there is no email functionality.
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="Ediarum Webdav"

# ---------------------------------------------------------------------------------------------
# Without Docker only. compose.yaml sets these itself and ignores the values here.
# ---------------------------------------------------------------------------------------------
APP_NAME='Ediarum Webdav'
APP_ENV=local
APP_DEBUG=true
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
# Same directory as WEBDAV_REPOSITORIES_DIR above, as the app sees it.
REPOSITORIES_DIRECTORY=
QUEUE_CONNECTION=database
CACHE_DRIVER=database
SESSION_DRIVER=database
SESSION_COOKIE=ediarum_session
BROADCAST_DRIVER=log
FILESYSTEM_DISK=local
LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
